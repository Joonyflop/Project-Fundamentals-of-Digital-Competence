#include <iostream>
#include <string>
using namespace std;
 
void moodRecommendation() {
    int choice;
 
    cout << "\n--- Mood Recommendation ---\n";
    cout << "How are you feeling?\n";
    cout << "1. Happy\n";
    cout << "2. Sad\n";
    cout << "3. Chill\n";
    cout << "4. Energetic\n";
    cout << "Enter choice (1-4): ";
    cin >> choice;
 
    if (choice == 1) {
        cout << "\nHappy songs:\n";
        cout << "1. Happy - Pharrell Williams\n";
        cout << "2. Uptown Funk - Mark Ronson ft. Bruno Mars\n";
        cout << "3. Good as Hell - Lizzo\n";
        cout << "Playlist: Happy Hits\n";
    }
    else if (choice == 2) {
        cout << "\nSad songs:\n";
        cout << "1. Someone Like You - Adele\n";
        cout << "2. Fix You - Coldplay\n";
        cout << "3. When I Was Your Man - Bruno Mars\n";
        cout << "Playlist: Sad Songs\n";
    }
    else if (choice == 3) {
        cout << "\nChill songs:\n";
        cout << "1. Location - Khalid\n";
        cout << "2. Ocean Eyes - Billie Eilish\n";
        cout << "3. Better Together - Jack Johnson\n";
        cout << "Playlist: Chill Hits\n";
    }
    else if (choice == 4) {
        cout << "\nEnergetic songs:\n";
        cout << "1. Titanium - David Guetta ft. Sia\n";
        cout << "2. Levitating - Dua Lipa\n";
        cout << "3. Blinding Lights - The Weeknd\n";
        cout << "Playlist: Power Workout\n";
    }
    else {
        cout << "Invalid choice. Please enter 1 to 4.\n";
    }
}
 
int main() {
    moodRecommendation();
    return 0;
}
 